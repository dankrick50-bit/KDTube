diff --git a/youtubeapi/src/main/assets/nsigsolver/lazy.ast.js b/youtubeapi/src/main/assets/nsigsolver/lazy.ast.js
new file mode 100644
index 00000000..f19db132
--- /dev/null
+++ b/youtubeapi/src/main/assets/nsigsolver/lazy.ast.js
@@ -0,0 +1,285 @@
+/*!
+ * Lazy AST for the challenge solvers.
+ *
+ * The solvers parse the whole player (megabytes of minified js) into an AST. Inside V8 that
+ * tree needs 130-190 MB, although the solvers look at a tiny part of it and most of the code
+ * is written back unchanged.
+ *
+ * If the host provides the positions of all function bodies (global __playerSpans:
+ * "start,end,start,end..." in source order, see rust/kdtube-core/src/jsfn.rs) then:
+ *   - the parser gets a skeleton of the player where the function bodies are cut out
+ *   - a body is parsed when (and only when) somebody reads it. The result is read only
+ *     and only the most recent ones are kept.
+ *   - the generator writes untouched bodies as they were in the source
+ *
+ * The solvers aren't changed and don't know about it: 'meriyah' and 'astring' are wrapped.
+ * Should be loaded after those two and before the solvers.
+ *
+ * Safety net: an attempt to modify a lazily parsed body throws (the nodes are frozen, the
+ * solvers are strict mode code). The host runs the solver again without __playerSpans then.
+ */
+(function (global) {
+  'use strict';
+
+  var realMeriyah = global.meriyah;
+  var realAstring = global.astring;
+
+  if (!realMeriyah || !realAstring || !realAstring.GENERATOR) {
+    return;
+  }
+
+  var FUNCTIONS = { FunctionDeclaration: true, FunctionExpression: true, ArrowFunctionExpression: true };
+  // What is left of a body in the skeleton: {"<MARK><index of the span>"}
+  var MARK = 'kd-lazy-body#';
+  // Not worth it for the tiny ones
+  var MIN_BODY_LENGTH = 48;
+  // Parsed bodies that are kept. Somebody who reads the same body twice in a row should get the
+  // same object. NOTE: WeakRef can't be used for that. Its target lives till the end of the
+  // current job and the whole solver is a single job.
+  var CACHE_SIZE = 16;
+  var cacheKeys = new Int32Array(CACHE_SIZE).fill(-1);
+  var cacheValues = new Array(CACHE_SIZE).fill(null);
+  var cachePos = 0;
+  // lazy block -> index of its span
+  var rawOf = new WeakMap();
+  var source = null;
+  var starts = null;
+  var ends = null;
+  // index of the first span that isn't inside of the given one
+  var next = null;
+
+  function prepare(code, spansText) {
+    var parts = spansText.split(',');
+    var count = parts.length >> 1;
+    var s = new Int32Array(count);
+    var e = new Int32Array(count);
+    var n = new Int32Array(count);
+    var stack = [];
+
+    for (var i = 0; i < count; i++) {
+      s[i] = +parts[2 * i];
+      e[i] = +parts[2 * i + 1];
+
+      // must be a pair of braces, in source order
+      if (!(e[i] > s[i] + 1) || code.charCodeAt(s[i]) !== 123 || code.charCodeAt(e[i] - 1) !== 125 || (i > 0 && s[i] <= s[i - 1])) {
+        return false;
+      }
+
+      while (stack.length && s[i] >= e[stack[stack.length - 1]]) {
+        n[stack.pop()] = i;
+      }
+
+      if (stack.length && e[i] > e[stack[stack.length - 1]]) {
+        return false; // overlapping
+      }
+
+      stack.push(i);
+    }
+
+    while (stack.length) {
+      n[stack.pop()] = count;
+    }
+
+    source = code;
+    starts = s;
+    ends = e;
+    next = n;
+    cacheKeys.fill(-1);
+    cacheValues.fill(null);
+
+    return count > 0;
+  }
+
+  /**
+   * Text of the region where the function bodies are replaced with their marks.
+   * A body that takes more than a half of the region is left as is (but not the ones inside of it):
+   * that's the function that wraps the whole player.
+   */
+  function skeleton(from, to, first, stop) {
+    var limit = (to - from) / 2;
+    var parts = [];
+    var pos = from;
+
+    (function visit(idx, end) {
+      while (idx < end) {
+        var s = starts[idx];
+        var e = ends[idx];
+
+        if (e - s > limit) {
+          visit(idx + 1, next[idx]);
+        } else if (e - s >= MIN_BODY_LENGTH) {
+          parts.push(source.slice(pos, s), '{"' + MARK + idx + '"}');
+          pos = e;
+        }
+
+        idx = next[idx];
+      }
+    })(first, stop);
+
+    parts.push(source.slice(pos, to));
+
+    return parts.join('');
+  }
+
+  /**
+   * @return index of the span if that's what is left of a body in the skeleton
+   */
+  function markOf(block) {
+    var statements = block.body;
+
+    if (statements.length === 1 && statements[0].type === 'ExpressionStatement') {
+      var expr = statements[0].expression;
+
+      if (expr.type === 'Literal' && typeof expr.value === 'string' && expr.value.startsWith(MARK)) {
+        var idx = +expr.value.slice(MARK.length);
+
+        if (idx >= 0 && idx < starts.length) {
+          return idx;
+        }
+      }
+    }
+
+    return -1;
+  }
+
+  function lazyBlock(idx, isAsync, isGenerator) {
+    var block = { type: 'BlockStatement' };
+
+    Object.defineProperty(block, 'body', {
+      enumerable: true,
+      get: function () {
+        for (var i = 0; i < CACHE_SIZE; i++) {
+          if (cacheKeys[i] === idx) {
+            return cacheValues[i];
+          }
+        }
+
+        var statements = parseBody(idx, isAsync, isGenerator);
+
+        cacheKeys[cachePos] = idx;
+        cacheValues[cachePos] = statements;
+        cachePos = (cachePos + 1) % CACHE_SIZE;
+
+        return statements;
+      }
+    });
+
+    rawOf.set(block, idx);
+
+    return Object.freeze(block);
+  }
+
+  /**
+   * Replaces what is left of the bodies with the lazy ones
+   */
+  function install(root, freeze) {
+    var stack = [root];
+
+    while (stack.length) {
+      var node = stack.pop();
+
+      if (Array.isArray(node)) {
+        for (var i = 0; i < node.length; i++) {
+          if (node[i] !== null && typeof node[i] === 'object') {
+            stack.push(node[i]);
+          }
+        }
+      } else {
+        if (FUNCTIONS[node.type] === true && node.body && node.body.type === 'BlockStatement') {
+          var idx = markOf(node.body);
+
+          if (idx !== -1) {
+            node.body = lazyBlock(idx, node.async === true, node.generator === true);
+          }
+        }
+
+        for (var key in node) {
+          var value = node[key];
+
+          // nodes and lists of nodes only (not a RegExp etc)
+          if (value !== null && typeof value === 'object' && (Array.isArray(value) || typeof value.type === 'string') && !rawOf.has(value)) {
+            stack.push(value);
+          }
+        }
+      }
+
+      if (freeze) {
+        Object.freeze(node);
+      }
+    }
+  }
+
+  function parseBody(idx, isAsync, isGenerator) {
+    var text = skeleton(starts[idx], ends[idx], idx + 1, next[idx]);
+    var block;
+
+    if (/\bsuper\s*\(/.test(text)) {
+      // only a constructor of a derived class can call it
+      block = realMeriyah.parse('class a extends b{constructor()' + text + '}').body[0].body.body[0].value.body;
+    } else {
+      // a method: 'super.x', 'new.target', 'arguments' and 'return' are fine
+      block = realMeriyah.parse('({' + (isAsync ? 'async ' : '') + (isGenerator ? '*' : '') + 'm()' + text + '})').body[0].expression.properties[0].value.body;
+    }
+
+    install(block.body, true);
+
+    return block.body;
+  }
+
+  function lazyParse(code, spansText) {
+    try {
+      if (!prepare(code, spansText)) {
+        return null;
+      }
+
+      var program = realMeriyah.parse(skeleton(0, code.length, 0, starts.length));
+
+      install(program, false);
+
+      return program;
+    } catch (e) {
+      // The positions don't fit. Not a problem: the regular way.
+      source = null;
+      return null;
+    }
+  }
+
+  var lazyGenerator = Object.assign({}, realAstring.GENERATOR, {
+    BlockStatement: function (node, state) {
+      var idx = rawOf.get(node);
+
+      if (idx !== undefined) {
+        state.write(source.slice(starts[idx], ends[idx]));
+      } else {
+        realAstring.GENERATOR.BlockStatement.call(this, node, state);
+      }
+    }
+  });
+
+  global.meriyah = Object.assign({}, realMeriyah, {
+    parse: function (code, options) {
+      if (options === undefined && typeof global.__playerSpans === 'string' && code === global.__player) {
+        var program = lazyParse(code, global.__playerSpans);
+
+        // for the host: was it used?
+        global.__lazyAst = program !== null;
+
+        if (program !== null) {
+          return program;
+        }
+      }
+
+      return realMeriyah.parse.apply(realMeriyah, arguments);
+    }
+  });
+
+  global.astring = Object.assign({}, realAstring, {
+    generate: function (node, options) {
+      if (source === null) {
+        return realAstring.generate(node, options);
+      }
+
+      return realAstring.generate(node, Object.assign({ generator: lazyGenerator }, options));
+    }
+  });
+})(globalThis);
diff --git a/youtubeapi/src/main/java/com/liskovsoft/googlecommon/common/converters/jsonpath/engine/JaywayNode.java b/youtubeapi/src/main/java/com/liskovsoft/googlecommon/common/converters/jsonpath/engine/JaywayNode.java
new file mode 100644
index 00000000..201f757f
--- /dev/null
+++ b/youtubeapi/src/main/java/com/liskovsoft/googlecommon/common/converters/jsonpath/engine/JaywayNode.java
@@ -0,0 +1,140 @@
+package com.liskovsoft.googlecommon.common.converters.jsonpath.engine;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonNull;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonPrimitive;
+import com.google.gson.internal.LazilyParsedNumber;
+import com.jayway.jsonpath.DocumentContext;
+import com.jayway.jsonpath.ParseContext;
+import com.jayway.jsonpath.PathNotFoundException;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Value inside a Gson tree, navigated with Jayway JsonPath.<br/>
+ * This is the reference engine. It's used when the native one isn't available.
+ */
+public final class JaywayNode implements JsonNode {
+    private final ParseContext mParser;
+    private final JsonElement mElement;
+    private DocumentContext mContext;
+
+    public JaywayNode(ParseContext parser, JsonElement element) {
+        mParser = parser;
+        mElement = element != null ? element : JsonNull.INSTANCE;
+    }
+
+    /**
+     * @param context already parsed document
+     */
+    public JaywayNode(ParseContext parser, DocumentContext context) {
+        this(parser, (JsonElement) context.json());
+        mContext = context;
+    }
+
+    @Override
+    public JsonNode read(JsonPathExpr path) {
+        if (mContext == null) {
+            // The old mapper did toString() + parse() on every value before reading from it.
+            // That's megabytes of garbage for nothing. Except one case: see below.
+            mContext = hasUnwrappedNumber(mElement) ? mParser.parse(mElement.toString()) : mParser.parse((Object) mElement);
+        }
+
+        Object result;
+
+        try {
+            result = mContext.read(path.jayway());
+        } catch (PathNotFoundException e) {
+            return null;
+        }
+
+        return new JaywayNode(mParser, (JsonElement) result);
+    }
+
+    @Override
+    public boolean isArray() {
+        return mElement instanceof JsonArray;
+    }
+
+    @Override
+    public boolean isObject() {
+        return mElement instanceof JsonObject;
+    }
+
+    @Override
+    public boolean isPrimitive() {
+        return mElement instanceof JsonPrimitive;
+    }
+
+    @Override
+    public List<JsonNode> elements() {
+        JsonArray array = (JsonArray) mElement;
+        List<JsonNode> result = new ArrayList<>(array.size());
+
+        for (JsonElement item : array) {
+            result.add(new JaywayNode(mParser, item));
+        }
+
+        return result;
+    }
+
+    @Override
+    public JsonPrimitive asPrimitive() {
+        return (JsonPrimitive) mElement;
+    }
+
+    /**
+     * Numbers that Jayway returns directly (not inside of an object or a nested array) aren't the ones
+     * Gson has parsed: GsonJsonProvider turns them into Integer, Long, Double or BigDecimal.
+     * Text round trip isn't a no-op for them (e.g. 1.5e3 -> Integer 1500 -> "1500").
+     * Such a number can only be the value itself or a direct item of a returned array.
+     */
+    private static boolean hasUnwrappedNumber(JsonElement element) {
+        if (element instanceof JsonArray) {
+            for (JsonElement item : (JsonArray) element) {
+                if (isUnwrappedNumber(item)) {
+                    return true;
+                }
+            }
+
+            return false;
+        }
+
+        return isUnwrappedNumber(element);
+    }
+
+    private static boolean isUnwrappedNumber(JsonElement element) {
+        if (element instanceof JsonPrimitive) {
+            JsonPrimitive primitive = (JsonPrimitive) element;
+            return primitive.isNumber() && !(primitive.getAsNumber() instanceof LazilyParsedNumber);
+        }
+
+        return false;
+    }
+
+    /**
+     * Diagnostics
+     */
+    JsonElement rawElement() {
+        return mElement;
+    }
+
+    /**
+     * NOTE: never dumps the content. It could be megabytes.
+     */
+    @Override
+    public String toString() {
+        if (mElement instanceof JsonPrimitive) {
+            return mElement.toString();
+        } else if (mElement instanceof JsonArray) {
+            return "JsonArray(size=" + ((JsonArray) mElement).size() + ")";
+        } else if (mElement instanceof JsonObject) {
+            return "JsonObject(size=" + ((JsonObject) mElement).size() + ")";
+        }
+
+        return "null";
+    }
+}
