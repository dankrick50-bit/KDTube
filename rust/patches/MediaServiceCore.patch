--- /dev/null
+++ b/youtubeapi/src/main/java/com/liskovsoft/googlecommon/common/converters/jsonpath/engine/NativeJson.java
@@ -0,0 +1,172 @@
+package com.liskovsoft.googlecommon.common.converters.jsonpath.engine;
+
+/**
+ * JNI bindings to the Rust core (<code>rust/kdtube-core</code>, <code>libkdtube_core.so</code>).<br/>
+ * <br/>
+ * The native side keeps the response bytes plus a compact index outside of the Java heap and
+ * evaluates JsonPath expressions on it. Values are addressed by <code>long</code> handles:
+ * <pre>
+ * bit  0..31  node reference
+ * bit  32     COPY - the value came out of a path evaluation
+ * bit  33     UNWRAPPED - number representation, see {@link #isUnwrapped(long)}
+ * bit  34..36 kind - one of the KIND_* constants
+ * bit  37     REPARSED - number representation, see {@link #isReparsed(long)}
+ * </pre>
+ * Negative values are status codes ({@link #NOT_FOUND}, {@link #UNSUPPORTED}).<br/>
+ * <br/>
+ * Nothing in here throws. Callers must treat {@link #UNSUPPORTED} (or a <code>null</code> result)
+ * as "replay this request on the Java engine".
+ */
+public final class NativeJson {
+    private static final String LIB_NAME = "kdtube_core";
+    /** Must match <code>ABI_VERSION</code> in rust/kdtube-core/src/lib.rs */
+    private static final int ABI_VERSION = 2;
+
+    /** Same meaning as Jayway's PathNotFoundException */
+    public static final long NOT_FOUND = -1;
+    /** The native engine can't answer. Use the Java engine instead. */
+    public static final long UNSUPPORTED = -2;
+
+    public static final int KIND_NULL = 0;
+    public static final int KIND_FALSE = 1;
+    public static final int KIND_TRUE = 2;
+    public static final int KIND_NUMBER = 3;
+    public static final int KIND_STRING = 4;
+    public static final int KIND_ARRAY = 5;
+    public static final int KIND_OBJECT = 6;
+
+    private static final long UNWRAPPED_BIT = 1L << 33;
+    private static final int KIND_SHIFT = 34;
+    private static final long REPARSED_BIT = 1L << 37;
+
+    private static final int STATE_UNKNOWN = 0;
+    private static final int STATE_AVAILABLE = 1;
+    private static final int STATE_UNAVAILABLE = 2;
+    private static volatile int sState = STATE_UNKNOWN;
+    private static volatile boolean sEnabled = true;
+
+    private NativeJson() {
+    }
+
+    /**
+     * @return true if the library is present, loadable on this device and speaks the expected ABI
+     */
+    public static boolean isAvailable() {
+        if (!sEnabled) {
+            return false;
+        }
+
+        int state = sState;
+
+        if (state == STATE_UNKNOWN) {
+            state = load();
+        }
+
+        return state == STATE_AVAILABLE;
+    }
+
+    /**
+     * Troubleshooting switch. When disabled everything goes through the Java engine.
+     */
+    public static void setEnabled(boolean enabled) {
+        sEnabled = enabled;
+    }
+
+    private static synchronized int load() {
+        if (sState != STATE_UNKNOWN) {
+            return sState;
+        }
+
+        int state = STATE_UNAVAILABLE;
+
+        try {
+            System.loadLibrary(LIB_NAME);
+            if (nAbiVersion() == ABI_VERSION) {
+                state = STATE_AVAILABLE;
+            }
+        } catch (Throwable e) {
+            // UnsatisfiedLinkError: lib isn't packaged for this abi, or the device is too old for it.
+            // SecurityException etc. Either way: the Java engine does the job.
+        }
+
+        sState = state;
+
+        return state;
+    }
+
+    public static int kind(long node) {
+        return (int) ((node >> KIND_SHIFT) & 7);
+    }
+
+    /**
+     * The number was read through an object property. Jayway's GsonJsonProvider "unwraps" such numbers
+     * (Integer, Long, Double, BigDecimal) and leaves array elements as is (LazilyParsedNumber).
+     */
+    public static boolean isUnwrapped(long node) {
+        return (node & UNWRAPPED_BIT) != 0;
+    }
+
+    /**
+     * Unwrapped number that has been taken out of a context. The old mapper used to serialize
+     * and to parse again every value before reading from it. So such number is lazily parsed again,
+     * but from the text of the unwrapped one (e.g. 1.5e3 -> Integer 1500 -> "1500").
+     */
+    public static boolean isReparsed(long node) {
+        return (node & REPARSED_BIT) != 0;
+    }
+
+    /**
+     * Not about json, but lives in the same library: where the function bodies of a script are.<br/>
+     * Used to make the JS challenge solvers parse the player lazily (see assets/nsigsolver/lazy.ast.js).
+     *
+     * @return "start,end,start,end..." (positions inside of the string, in source order),
+     * or null if the library isn't available or the source can't be parsed
+     */
+    public static String jsFunctionBodySpans(String source) {
+        if (source == null || !isAvailable()) {
+            return null;
+        }
+
+        return nJsFunctionSpans(source);
+    }
+
+    static native String nJsFunctionSpans(String source);
+
+    static native int nAbiVersion();
+
+    /** @return document handle, or 0 */
+    static native long nCreate(int capacityHint);
+
+    /** @return 0 on success */
+    static native int nAppend(long doc, byte[] buf, int len);
+
+    /** @return 0 on success. Anything else: the content isn't strict json (the Java engine may still accept it). */
+    static native int nFinish(long doc, boolean skipFirstLine);
+
+    static native void nFree(long doc);
+
+    static native long nRoot(long doc);
+
+    /** @return path handle (&gt; 0), or 0 if the expression isn't supported natively */
+    static native long nCompilePath(String path);
+
+    static native long nEval(long doc, long ctx, long path);
+
+    /** Same as {@link #nEval} but for an expression that shouldn't be kept on the native side */
+    static native long nEvalText(long doc, long ctx, String path);
+
+    /** @return string value or number text. Null if the node is of other kind or can't be represented. */
+    static native String nText(long doc, long node);
+
+    /** @return array elements, or null if the node isn't an array */
+    static native long[] nElements(long doc, long node);
+
+    /** Diagnostics: [key0, value0, key1, value1...], or null if the node isn't an object */
+    static native long[] nMembers(long doc, long node);
+
+    /** @return the bytes as they were appended */
+    static native byte[] nBytes(long doc);
+
+    /** Diagnostics: [input bytes, index entries, native heap bytes] */
+    static native long[] nStats(long doc);
+}
