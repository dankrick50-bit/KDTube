+package com.liskovsoft.googlecommon.common.converters.jsonpath.engine;
+
+/**
+ * The native engine can't process this document or expression.<br/>
+ * Not an error: the request should be replayed on the Java engine.
+ */
+public final class NativeUnsupportedException extends RuntimeException {
+    public NativeUnsupportedException(String message) {
+        super(message);
+    }
+
+    /**
+     * Used for flow control only. No need for the stack trace.
+     */
+    @Override
+    public synchronized Throwable fillInStackTrace() {
+        return this;
+    }
+}
