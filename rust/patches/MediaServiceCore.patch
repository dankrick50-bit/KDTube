+++ b/youtubeapi/src/main/java/com/liskovsoft/googlecommon/common/converters/jsonpath/engine/JsonNode.java
@@ -0,0 +1,39 @@
+package com.liskovsoft.googlecommon.common.converters.jsonpath.engine;
+
+import com.google.gson.JsonPrimitive;
+
+import java.util.List;
+
+/**
+ * Json value as the mapper sees it. Hides where the document actually lives:
+ * in a Gson tree ({@link JaywayNode}) or outside of the Java heap ({@link NativeDocument}).
+ */
+public interface JsonNode {
+    /**
+     * Same contract as Jayway's <code>DocumentContext.read(path)</code> (GsonJsonProvider, default options).
+     *
+     * @return null if Jayway would throw PathNotFoundException. Note, json null is a regular (non-null) node.
+     */
+    JsonNode read(JsonPathExpr path);
+
+    boolean isArray();
+
+    boolean isObject();
+
+    /**
+     * String, number or boolean
+     */
+    boolean isPrimitive();
+
+    /**
+     * Call only if {@link #isArray()}
+     */
+    List<JsonNode> elements();
+
+    /**
+     * Call only if {@link #isPrimitive()}
+     *
+     * @return the same value (including the number representation) that Jayway returns
+     */
+    JsonPrimitive asPrimitive();
+}
diff --git a/youtubeapi/src/main/java/com/liskovsoft/googlecommon/common/converters/jsonpath/engine/JsonPathExpr.java b/youtubeapi/src/main/java/com/liskovsoft/googlecommon/common/converters/jsonpath/engine/JsonPathExpr.java
new file mode 100644
index 00000000..85d6df75
--- /dev/null
+++ b/youtubeapi/src/main/java/com/liskovsoft/googlecommon/common/converters/jsonpath/engine/JsonPathExpr.java
@@ -0,0 +1,91 @@
+package com.liskovsoft.googlecommon.common.converters.jsonpath.engine;
+
+import com.jayway.jsonpath.JsonPath;
+
+/**
+ * Path expression that is compiled once per engine.<br/>
+ * The same few hundred expressions are evaluated many thousands of times per response.
+ */
+public final class JsonPathExpr {
+    private static final long NOT_COMPILED = 0;
+    private static final long UNSUPPORTED = -1;
+    private final String mSource;
+    private final boolean mTemporary;
+    private volatile long mNativeHandle = NOT_COMPILED;
+    private volatile JsonPath mJayway;
+
+    /**
+     * Expression that lives as long as the app does (e.g. comes from an annotation)
+     */
+    public JsonPathExpr(String source) {
+        this(source, false);
+    }
+
+    private JsonPathExpr(String source, boolean temporary) {
+        mSource = source;
+        mTemporary = temporary;
+    }
+
+    /**
+     * Expression that is built at runtime. The native side compiles it on each use and doesn't keep it.
+     */
+    public static JsonPathExpr temporary(String source) {
+        return new JsonPathExpr(source, true);
+    }
+
+    boolean isTemporary() {
+        return mTemporary;
+    }
+
+    public static JsonPathExpr[] from(String[] sources) {
+        if (sources == null) {
+            return null;
+        }
+
+        JsonPathExpr[] result = new JsonPathExpr[sources.length];
+
+        for (int i = 0; i < sources.length; i++) {
+            result[i] = new JsonPathExpr(sources[i]);
+        }
+
+        return result;
+    }
+
+    /**
+     * @return handle (&gt; 0), or -1 if the native engine doesn't support this expression
+     */
+    long nativeHandle() {
+        long handle = mNativeHandle;
+
+        if (handle == NOT_COMPILED) {
+            handle = mSource != null ? NativeJson.nCompilePath(mSource) : UNSUPPORTED;
+
+            if (handle <= 0) {
+                handle = UNSUPPORTED;
+            }
+
+            mNativeHandle = handle;
+        }
+
+        return handle;
+    }
+
+    /**
+     * NOTE: a broken expression throws on each call. Same as <code>DocumentContext.read(String)</code>
+     */
+    JsonPath jayway() {
+        JsonPath result = mJayway;
+
+        if (result == null) {
+            result = JsonPath.compile(mSource);
+            mJayway = result;
+        }
+
+        return result;
+    }
+
+    @Override
+    public String toString() {
+        return mSource;
+    }
+}
diff --git a/youtubeapi/src/main/java/com/liskovsoft/googlecommon/common/converters/jsonpath/engine/NativeDocument.java b/youtubeapi/src/main/java/com/liskovsoft/googlecommon/common/converters/jsonpath/engine/NativeDocument.java
