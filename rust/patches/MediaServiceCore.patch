+package com.liskovsoft.youtubeapi.app.nsigsolver.common
+
+import com.liskovsoft.googlecommon.common.converters.jsonpath.engine.NativeJson
+import com.liskovsoft.googlecommon.common.js.V8LowMemory
+
+/**
+ * Low memory mode of the challenge solvers.
+ *
+ * The first solve for a new player parses the whole player (megabytes of js) inside the JS engine.
+ * That takes 130-190 MB of the engine's heap and running out of it kills the app, not just the solver.
+ * With the positions of the function bodies (found by the native lib) the solvers parse a body only
+ * when they read it: about 40 MB. It's slower, so that's for the devices that need it.
+ * More: assets/nsigsolver/lazy.ast.js
+ */
+internal object LazyAst {
+    /**
+     * Should be loaded after the parser/generator libs and before the solver
+     */
+    const val scriptFilename = "nsigsolver/lazy.ast.js"
+
+    /**
+     * Name of the global variable that should hold the result of [getSpans]
+     */
+    const val spansVar = "__playerSpans"
+
+    /**
+     * @return null: the regular way (enough memory, no native lib or the player can't be parsed by it)
+     */
+    fun getSpans(player: String): String? {
+        if (!isWanted()) {
+            return null
+        }
+
+        return try {
+            NativeJson.jsFunctionBodySpans(player)
+        } catch (e: Throwable) {
+            null
+        }
+    }
+
+    fun loadScript(): String {
+        return try {
+            loadScript(scriptFilename)
+        } catch (e: ScriptLoaderError) {
+            "" // the solvers work without it
+        }
+    }
+
+    private fun isWanted() = V8LowMemory.isLowRamDevice()
+}
