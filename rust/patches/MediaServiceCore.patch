new file mode 100644
index 00000000..ef356157
--- /dev/null
+++ b/youtubeapi/src/main/java/com/liskovsoft/googlecommon/common/converters/jsonpath/typeadapter/ClassSchema.java
@@ -0,0 +1,112 @@
+package com.liskovsoft.googlecommon.common.converters.jsonpath.typeadapter;
+
+import com.liskovsoft.googlecommon.common.converters.jsonpath.JsonPath;
+import com.liskovsoft.googlecommon.common.converters.jsonpath.JsonPathObj;
+import com.liskovsoft.googlecommon.common.converters.jsonpath.engine.JsonPathExpr;
+import com.liskovsoft.googlecommon.common.helpers.ReflectionHelper;
+
+import java.lang.reflect.Constructor;
+import java.lang.reflect.Field;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Everything the mapper needs to know about a model class. Collected once.<br/>
+ * Before, the fields and their annotations were looked up again for every single object
+ * (thousands of times per response).
+ */
+final class ClassSchema {
+    private static final ConcurrentHashMap<Class<?>, ClassSchema> sCache = new ConcurrentHashMap<>();
+    private final Class<?> mType;
+    private final Constructor<?> mConstructor;
+    /**
+     * Annotation on the class itself. Null if there's none.
+     */
+    final JsonPathExpr[] classPaths;
+    /**
+     * Annotated fields only. Same order as {@link ReflectionHelper#getAllFields(Class)}
+     */
+    final FieldSchema[] fields;
+
+    static final class FieldSchema {
+        final Field field;
+        final JsonPathExpr[] paths;
+        final boolean isJsonPathObj;
+        private Class<?> mGenericParamType;
+        private boolean mGenericParamResolved;
+
+        FieldSchema(Field field, JsonPathExpr[] paths) {
+            this.field = field;
+            this.paths = paths;
+            this.isJsonPathObj = JsonPathObj.class.isAssignableFrom(field.getType());
+        }
+
+        /**
+         * Item type of the list
+         */
+        Class<?> getGenericParamType() {
+            if (!mGenericParamResolved) {
+                // NOTE: may throw (e.g. list of lists). The result isn't remembered in this case.
+                mGenericParamType = ReflectionHelper.getGenericParamType(field);
+                mGenericParamResolved = true;
+            }
+
+            return mGenericParamType;
+        }
+    }
+
+    static ClassSchema of(Class<?> type) {
+        ClassSchema schema = sCache.get(type);
+
+        if (schema == null) {
+            schema = new ClassSchema(type);
+            ClassSchema existing = sCache.putIfAbsent(type, schema);
+
+            if (existing != null) {
+                schema = existing;
+            }
+        }
+
+        return schema;
+    }
+
+    private ClassSchema(Class<?> type) {
+        mType = type;
+
+        Constructor<?> constructor = null;
+
+        try {
+            constructor = type.getConstructor();
+        } catch (Exception e) {
+            // No public constructor. Will be reported on instantiation.
+        }
+
+        mConstructor = constructor;
+
+        JsonPath classAnnotation = type.getAnnotation(JsonPath.class);
+        classPaths = classAnnotation != null ? JsonPathExpr.from(classAnnotation.value()) : null;
+
+        List<FieldSchema> result = new ArrayList<>();
+
+        for (Field field : ReflectionHelper.getAllFields(type)) {
+            JsonPath annotation = field.getAnnotation(JsonPath.class);
+
+            if (annotation == null) {
+                continue;
+            }
+
+            field.setAccessible(true);
+            result.add(new FieldSchema(field, JsonPathExpr.from(annotation.value())));
+        }
+
+        fields = result.toArray(new FieldSchema[0]);
+    }
+
+    Object newInstance() throws Exception {
+        // NOTE: getConstructor throws the original exception if there's no suitable constructor
+        Constructor<?> constructor = mConstructor != null ? mConstructor : mType.getConstructor();
+
+        return constructor.newInstance();
+    }
+}
