new file mode 100644
index 00000000..6ba9a25b
--- /dev/null
+++ b/youtubeapi/src/main/java/com/liskovsoft/googlecommon/common/converters/jsonpath/engine/NativeNode.java
@@ -0,0 +1,175 @@
+package com.liskovsoft.googlecommon.common.converters.jsonpath.engine;
+
+import com.google.gson.JsonPrimitive;
+import com.google.gson.internal.LazilyParsedNumber;
+import com.jayway.jsonpath.spi.json.GsonJsonProvider;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Value inside a {@link NativeDocument}. Just a handle: nothing is copied to the Java heap
+ * until a primitive is requested.
+ */
+final class NativeNode implements JsonNode {
+    private static final GsonJsonProvider sProvider = new GsonJsonProvider();
+    private final NativeDocument mDocument;
+    private final long mNode;
+
+    NativeNode(NativeDocument document, long node) {
+        mDocument = document;
+        mNode = node;
+    }
+
+    @Override
+    public JsonNode read(JsonPathExpr path) {
+        long result;
+
+        if (path.isTemporary()) {
+            result = NativeJson.nEvalText(mDocument.handle(), mNode, path.toString());
+        } else {
+            long pathHandle = path.nativeHandle();
+
+            if (pathHandle <= 0) {
+                throw new NativeUnsupportedException("Unsupported path: " + path);
+            }
+
+            result = NativeJson.nEval(mDocument.handle(), mNode, pathHandle);
+        }
+
+        if (result == NativeJson.NOT_FOUND) {
+            return null;
+        }
+
+        if (result < 0) {
+            throw new NativeUnsupportedException("Can't evaluate: " + path);
+        }
+
+        return new NativeNode(mDocument, result);
+    }
+
+    @Override
+    public boolean isArray() {
+        return NativeJson.kind(mNode) == NativeJson.KIND_ARRAY;
+    }
+
+    @Override
+    public boolean isObject() {
+        return NativeJson.kind(mNode) == NativeJson.KIND_OBJECT;
+    }
+
+    @Override
+    public boolean isPrimitive() {
+        int kind = NativeJson.kind(mNode);
+        return kind == NativeJson.KIND_STRING || kind == NativeJson.KIND_NUMBER ||
+                kind == NativeJson.KIND_TRUE || kind == NativeJson.KIND_FALSE;
+    }
+
+    @Override
+    public List<JsonNode> elements() {
+        long[] items = NativeJson.nElements(mDocument.handle(), mNode);
+
+        if (items == null) {
+            throw new NativeUnsupportedException("Can't get the elements");
+        }
+
+        List<JsonNode> result = new ArrayList<>(items.length);
+
+        for (long item : items) {
+            result.add(new NativeNode(mDocument, item));
+        }
+
+        return result;
+    }
+
+    @Override
+    public JsonPrimitive asPrimitive() {
+        switch (NativeJson.kind(mNode)) {
+            case NativeJson.KIND_STRING:
+                return new JsonPrimitive(text());
+            case NativeJson.KIND_TRUE:
+                return new JsonPrimitive(Boolean.TRUE);
+            case NativeJson.KIND_FALSE:
+                return new JsonPrimitive(Boolean.FALSE);
+            case NativeJson.KIND_NUMBER:
+                // The same object Gson creates while parsing
+                JsonPrimitive number = new JsonPrimitive(new LazilyParsedNumber(text()));
+                boolean reparsed = NativeJson.isReparsed(mNode);
+
+                if (reparsed || NativeJson.isUnwrapped(mNode)) {
+                    // Jayway: GsonJsonProvider.getMapValue() unwraps the number (Integer, Long, Double...)
+                    // and the result array wraps it again. Array items are left as is.
+                    Object unwrapped = sProvider.unwrap(number);
+
+                    if (unwrapped instanceof Number) {
+                        number = new JsonPrimitive((Number) unwrapped);
+                    }
+
+                    if (reparsed) {
+                        // ...and then the old mapper did toString() + parse() on the array that holds it
+                        number = new JsonPrimitive(new LazilyParsedNumber(number.toString()));
+                    }
+                }
+
+                return number;
+        }
+
+        throw new IllegalStateException("Not a primitive: " + this);
+    }
+
+    private String text() {
+        String text = NativeJson.nText(mDocument.handle(), mNode);
+
+        if (text == null) {
+            // E.g. lone surrogate. Java string can hold it but the native one can't.
+            throw new NativeUnsupportedException("Can't get the text");
+        }
+
+        return text;
+    }
+
+    @Override
+    public String toString() {
+        switch (NativeJson.kind(mNode)) {
+            case NativeJson.KIND_ARRAY:
+                return "JsonArray";
+            case NativeJson.KIND_OBJECT:
+                return "JsonObject";
+            case NativeJson.KIND_NULL:
+                return "null";
+            case NativeJson.KIND_TRUE:
+                return "true";
+            case NativeJson.KIND_FALSE:
+                return "false";
+            default:
+                String text = NativeJson.nText(mDocument.handle(), mNode);
+                return text != null ? text : "?";
+        }
+    }
+
+    /**
+     * Diagnostics
+     */
+    long handle() {
+        return mNode;
+    }
+
+    /**
+     * Diagnostics: [key0, value0, key1, value1...]
+     */
+    List<NativeNode> members() {
+        long[] items = NativeJson.nMembers(mDocument.handle(), mNode);
+
+        if (items == null) {
+            throw new NativeUnsupportedException("Can't get the members");
+        }
+
+        List<NativeNode> result = new ArrayList<>(items.length);
+
+        for (long item : items) {
+            result.add(new NativeNode(mDocument, item));
+        }
+
+        return result;
+    }
+}
