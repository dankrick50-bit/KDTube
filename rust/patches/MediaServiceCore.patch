index 00000000..dcc4288a
--- /dev/null
+++ b/youtubeapi/src/main/java/com/liskovsoft/googlecommon/common/converters/jsonpath/engine/NativeDocument.java
@@ -0,0 +1,189 @@
+package com.liskovsoft.googlecommon.common.converters.jsonpath.engine;
+
+import java.io.ByteArrayInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.SequenceInputStream;
+import java.util.concurrent.atomic.AtomicLong;
+
+/**
+ * Document that lives outside of the Java heap (see <code>rust/kdtube-core</code>).<br/>
+ * <br/>
+ * The response is streamed to the native side in small chunks, so the Java heap never holds
+ * the whole content, its String form or a tree of it. Measured on the biggest recorded response
+ * (subscriptions, 1.5 MB): the old mapper allocated 100 MB on the Java heap, this one allocates
+ * 6 MB (the model itself, mostly) plus 2.4 MB of native memory that is freed on close.<br/>
+ * <br/>
+ * Must be closed. Nodes of a closed document can't be used.
+ */
+public final class NativeDocument {
+    private static final int BUFFER_SIZE = 16 * 1024;
+    private static final AtomicLong sLoaded = new AtomicLong();
+    private static final AtomicLong sReplayed = new AtomicLong();
+    private long mHandle;
+    private boolean mReady;
+    // What isn't on the native side (if something went wrong while reading)
+    private IOException mReadError;
+    private byte[] mPending;
+    private int mPendingLen;
+    private InputStream mRest;
+
+    private NativeDocument(long handle) {
+        mHandle = handle;
+    }
+
+    /**
+     * Moves the content of the stream to the native side and builds an index over it.
+     *
+     * @return null if the native engine isn't available. Nothing is consumed from the stream in this case.
+     */
+    public static NativeDocument load(InputStream is, boolean skipFirstLine) {
+        if (is == null || !NativeJson.isAvailable()) {
+            return null;
+        }
+
+        long handle = NativeJson.nCreate(0);
+
+        if (handle == 0) {
+            return null;
+        }
+
+        NativeDocument doc = new NativeDocument(handle);
+
+        try {
+            doc.fill(is, skipFirstLine);
+        } catch (RuntimeException | Error e) {
+            // Unusual stream. Nobody will close the document if it isn't returned.
+            doc.close();
+            throw e;
+        }
+
+        sLoaded.incrementAndGet();
+
+        return doc;
+    }
+
+    /**
+     * Diagnostics: number of documents that went to the native side since the app start
+     */
+    public static long getLoadedCount() {
+        return sLoaded.get();
+    }
+
+    /**
+     * Diagnostics: how many of them had to be processed by the Java engine after all
+     */
+    public static long getReplayedCount() {
+        return sReplayed.get();
+    }
+
+    private void fill(InputStream is, boolean skipFirstLine) {
+        byte[] buffer = new byte[BUFFER_SIZE];
+
+        try {
+            int len;
+            while ((len = is.read(buffer)) != -1) {
+                if (len > 0 && NativeJson.nAppend(mHandle, buffer, len) != 0) {
+                    // Too big? Keep the part that isn't stored.
+                    mPending = buffer;
+                    mPendingLen = len;
+                    mRest = is;
+                    return;
+                }
+            }
+        } catch (IOException e) {
+            // Connection problems etc. The Java engine decides what to do with it (see replay).
+            mReadError = e;
+            return;
+        }
+
+        mReady = NativeJson.nFinish(mHandle, skipFirstLine) == 0;
+    }
+
+    /**
+     * @return false if the content should be processed by the Java engine (not a strict json, read error etc)
+     */
+    public boolean isReady() {
+        return mReady;
+    }
+
+    public JsonNode root() {
+        long root = NativeJson.nRoot(handle());
+
+        if (root < 0) {
+            throw new NativeUnsupportedException("No root");
+        }
+
+        return new NativeNode(this, root);
+    }
+
+    /**
+     * @return the original stream content (including the part that wasn't read and the read error, if any)
+     */
+    public InputStream replay() {
+        byte[] bytes = NativeJson.nBytes(handle());
+
+        if (bytes == null) {
+            throw new IllegalStateException("Can't get the content back from the native side");
+        }
+
+        sReplayed.incrementAndGet();
+
+        InputStream result = new ByteArrayInputStream(bytes);
+
+        if (mPending != null) {
+            result = new SequenceInputStream(result,
+                    new SequenceInputStream(new ByteArrayInputStream(mPending, 0, mPendingLen), mRest));
+        } else if (mReadError != null) {
+            result = new SequenceInputStream(result, new FailedInputStream(mReadError));
+        }
+
+        return result;
+    }
+
+    public void close() {
+        long handle = mHandle;
+        mHandle = 0;
+        mReady = false;
+
+        if (handle != 0) {
+            NativeJson.nFree(handle);
+        }
+    }
+
+    /**
+     * Diagnostics: [input bytes, index entries, native heap bytes]
