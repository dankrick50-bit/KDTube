+package com.liskovsoft.googlecommon.common.js;
+
+import com.eclipsesource.v8.V8;
+import com.liskovsoft.sharedutils.helpers.DeviceHelpers;
+import com.liskovsoft.youtubeapi.app.AppService;
+
+/**
+ * Settings of the JS engine for the devices where memory is tight.
+ */
+public final class V8LowMemory {
+    // Devices that are sold as "3 GB" and less
+    private static final long LOW_RAM_BYTES = 3_500_000_000L;
+    private static boolean sApplied;
+
+    private V8LowMemory() {
+    }
+
+    public static boolean isLowRamDevice() {
+        long ram;
+
+        try {
+            ram = DeviceHelpers.getDeviceRam(AppService.instance().getContext());
+        } catch (Exception e) {
+            ram = -1;
+        }
+
+        // unknown amount: the safe way
+        return ram <= LOW_RAM_BYTES;
+    }
+
+    /**
+     * Should be called before an engine is created. The flags are process wide and the first engine fixes them.<br/>
+     * Makes the engine collect the garbage instead of growing: 40-50 MB less at the peak of the
+     * challenge solvers, a bit slower.<br/>
+     * NOTE: a limit of the heap size isn't used on purpose. Reaching it kills the whole app.
+     */
+    public static synchronized void apply() {
+        if (sApplied) {
+            return;
+        }
+
+        sApplied = true;
+
+        if (isLowRamDevice()) {
+            try {
+                V8.setFlags("--optimize-for-size");
+            } catch (Throwable e) {
+                // the engine works without it
+            }
+        }
+    }
+}
